# Copy to .env.development.local and adjust if needed.

# Dev proxy target — must match uvicorn --port
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Dev fetch prefix (Vite rewrites /api → backend root)
VITE_API_URL=/api

# Integrated build (npm run build): leave VITE_API_URL unset so fetch hits /health directly
