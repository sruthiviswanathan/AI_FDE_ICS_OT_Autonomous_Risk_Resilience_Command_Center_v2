  "required": [
    "event_id",
    "tag_id",
    "asset_id",
    "event_time",
    "ingest_time",
    "value",
    "unit",
    "quality",
    "source",
    "provenance"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "tag_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "event_time": { "type": "string" },
    "ingest_time": { "type": "string" },
    "value": { "type": "number" },
    "unit": { "type": "string" },
