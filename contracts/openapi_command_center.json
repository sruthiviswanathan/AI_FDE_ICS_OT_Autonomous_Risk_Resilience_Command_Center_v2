  "components": {
    "schemas": {
      "EvalRunRequest": {
        "properties": {
          "case_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Ids",
            "description": "Optional subset; default all EVAL-001\u2026031"
          }
        },
        "type": "object",
        "title": "EvalRunRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecommendRequest": {
        "properties": {
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "plant_id": {
            "type": "string",
            "title": "Plant Id"
          },
          "as_of": {
            "type": "string",
            "title": "As Of",
            "default": "workshop-static"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "default": "policy.py:ACTION_TIERS"
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id"
          },
          "alert_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alert Id"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "process_context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Process Context"
          }
        },
        "type": "object",
        "required": [
          "actor",
          "purpose",
          "plant_id"
        ],
        "title": "RecommendRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
